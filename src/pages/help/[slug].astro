---
import { getCollection, getEntry, render } from 'astro:content'
import { isClientOnly } from '@cf-dam/api'
import AppLayout from '../../layouts/AppLayout.astro'
import { HELP_SECTIONS } from '../../lib/help'

const entry = await getEntry('help', Astro.params.slug ?? '')
if (!entry) return Astro.redirect('/help')
const { Content, headings } = await render(entry)
const all = (await getCollection('help')).sort((a, b) => a.data.order - b.data.order)
const siblings = all.filter((a) => a.data.section === entry.data.section)
const contents = headings.filter((h) => h.depth === 2)
// A client reads only their own article (the middleware sees to that), so no list of the rest.
const client = isClientOnly(Astro.locals.principal!.roles)
---
<AppLayout title={entry.data.title} subtitle={entry.data.summary}>
  <div class:list={['help', { solo: client }]}>
    {!client && <nav class="side" aria-label="Help">
      <a class="back" href="/help">← All help</a>
      {HELP_SECTIONS.map((section) => (
        <details open={section === entry.data.section}>
          <summary>{section}</summary>
          <ul>
            {all.filter((a) => a.data.section === section).map((a) => (
              <li><a href={`/help/${a.id}`} aria-current={a.id === entry.id ? 'page' : undefined}>{a.data.title}</a></li>
            ))}
          </ul>
        </details>
      ))}
    </nav>}
    <article class="card prose">
      {contents.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <strong>On this page</strong>
          <ul>{contents.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </nav>
      )}
      <Content />
      {!client && siblings.length > 1 && (
        <footer class="more">
          <strong>More in {entry.data.section}</strong>
          <ul>{siblings.filter((a) => a.id !== entry.id).map((a) => <li><a href={`/help/${a.id}`}>{a.data.title}</a>: {a.data.summary}</li>)}</ul>
        </footer>
      )}
    </article>
  </div>
</AppLayout>

<style>
  .help {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .help.solo {
    grid-template-columns: minmax(0, 1fr);
    max-width: 860px;
  }
  .side {
    position: sticky;
    top: 20px;
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
  }
  .side summary {
    cursor: pointer;
    font-weight: 600;
    padding: 4px 0;
  }
  .side ul,
  .toc ul,
  .more ul {
    margin: 4px 0 8px;
    padding-left: 16px;
  }
  .side li {
    margin: 3px 0;
  }
  .side a[aria-current='page'] {
    font-weight: 700;
    color: var(--text);
  }
  .back {
    margin-bottom: 6px;
  }
  .prose {
    max-width: 78ch;
    line-height: 1.65;
  }
  .prose :global(h2) {
    margin-top: 1.8em;
    font-size: 1.2rem;
  }
  .prose :global(h3) {
    margin-top: 1.4em;
    font-size: 1.02rem;
  }
  .prose :global(li) {
    margin: 0.3em 0;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--surface-hover);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--surface-strong);
    border: 1px solid var(--border);
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(blockquote) {
    margin: 1em 0;
    padding: 10px 14px;
    border-left: 3px solid var(--accent);
    background: var(--surface-hover);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .prose :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 6px 10px;
    text-align: left;
    vertical-align: top;
  }
  .toc {
    float: right;
    margin: 0 0 12px 20px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    max-width: 240px;
  }
  .more {
    margin-top: 2.5em;
    padding-top: 1em;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }
  @media (max-width: 980px) {
    .help {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
    .toc {
      float: none;
      margin: 0 0 12px;
    }
  }
</style>
