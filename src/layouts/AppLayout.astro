---
import Base from './Base.astro'
import Logo from '../components/Logo.astro'
import SignOut from '../components/SignOut.svelte'

interface Props {
  title: string
  subtitle?: string
}
const { title, subtitle } = Astro.props
const principal = Astro.locals.principal!
const path = Astro.url.pathname

interface NavItem {
  href: string
  label: string
  icon: string
  soon?: string
  needs?: string
}
// Icons are 24×24 stroke paths.
const nav: NavItem[] = [
  { href: '/', label: 'Library', icon: 'M4 5h16v14H4z M4 15l4.5-4.5 4 4 2.5-2.5L20 17' },
  { href: '/albums', label: 'Albums', icon: 'M5 7h14v12H5z M8 4h8' },
  { href: '/keywords', label: 'Keywords', icon: 'M3 12V4h8l9 9-8 8z M7.5 7.5h.01', needs: 'assets:read' },
  { href: '/presets', label: 'Presets', icon: 'M6 3h9l4 4v14H6z M14 3v5h5 M9 12h7 M9 16h5', needs: 'assets:read' },
  { href: '/duplicates', label: 'Duplicates', icon: 'M8 8h11v11H8z M5 16V5h11' },
  { href: '/settings/ai', label: 'AI review', icon: 'M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z M18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9z', needs: 'ai:run' },
  { href: '/settings/storage', label: 'Storage', icon: 'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z M4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7 M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3', needs: 'sources:manage' },
  { href: '/sources', label: 'NAS agents', icon: 'M4 6h16v5H4z M4 13h16v5H4z M7 8.5h.01 M7 15.5h.01', needs: 'sources:manage' },
  { href: '/lifecycle', label: 'Lifecycle', icon: 'M4 7h16 M7 12h10 M10 17h4', soon: 'Phase 6' },
  { href: '/admin/users', label: 'People', icon: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M3 20c.8-3.4 3.3-5 6-5s5.2 1.6 6 5 M16 4.5a3.5 3.5 0 0 1 0 6.5 M18 15c1.6.6 2.7 2.2 3 5', needs: 'users:manage' },
  { href: '/account', label: 'Account', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21c1-4 4.3-6 8-6s7 2 8 6' },
]
const visible = nav.filter((item) => !item.needs || principal.permissions.has(item.needs))
const initials = (principal.name || principal.email)
  .split(/\s+/)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .slice(0, 2)
  .join('')
---
<Base title={title}>
  <div class="shell">
    <aside class="sidebar">
      <a class="brand" href="/"><Logo /><span>cf-dam</span></a>
      <nav>
        {visible.map((item) => {
          const active = item.href === '/' ? path === '/' : path.startsWith(item.href)
          return item.soon ? (
            <span class="nav-item disabled" title={`Coming in ${item.soon}`}>
              <svg viewBox="0 0 24 24"><path d={item.icon} /></svg>
              {item.label}
              <span class="soon">{item.soon}</span>
            </span>
          ) : (
            <a class:list={['nav-item', { active }]} href={item.href} aria-current={active ? 'page' : undefined}>
              <svg viewBox="0 0 24 24"><path d={item.icon} /></svg>
              {item.label}
            </a>
          )
        })}
      </nav>
      <div class="me">
        <span class="avatar">{initials}</span>
        <div class="who">
          <strong>{principal.name || principal.email}</strong>
          <span class="muted">{principal.roles.join(', ')}</span>
        </div>
      </div>
      <SignOut client:load />
    </aside>

    <script is:inline>
      // ⌘K / Ctrl+K focuses search, as in most modern apps.
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault()
          document.getElementById('global-search')?.focus()
        }
      })
    </script>
    <main class="content">
      <header class="page-head">
        <div>
          <h1>{title}</h1>
          {subtitle && <p class="muted">{subtitle}</p>}
        </div>
        <form class="search" action="/" method="get" role="search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14z M20 20l-4-4" /></svg>
          <input id="global-search" type="search" name="q" placeholder="Search the archive" value={Astro.url.searchParams.get('q') ?? ''} aria-label="Search the archive" />
          <kbd>⌘K</kbd>
        </form>
      </header>
      <slot />
    </main>
  </div>
</Base>

<style>
  .shell {
    display: grid;
    grid-template-columns: 248px 1fr;
    min-height: 100vh;
  }
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 14px;
    border-right: 1px solid var(--border);
    background: linear-gradient(180deg, var(--bg-elevated), var(--bg));
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 8px 18px;
    color: var(--text);
    font-weight: 650;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    text-decoration: none;
  }
  nav {
    display: grid;
    gap: 2px;
    flex: 1;
    align-content: start;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-weight: 500;
    transition: background 150ms var(--ease), color 150ms var(--ease);
  }
  .nav-item svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  a.nav-item:hover {
    background: var(--surface-hover);
    color: var(--text);
    text-decoration: none;
  }
  .nav-item.active {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .nav-item.disabled {
    opacity: 0.5;
    cursor: default;
  }
  .soon {
    margin-left: auto;
    font-size: 0.68rem;
    color: var(--text-faint);
  }
  .me {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 8px;
    border-top: 1px solid var(--border);
  }
  .avatar {
    width: 34px;
    height: 34px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, var(--accent-strong), var(--accent-2));
  }
  .who {
    display: grid;
    min-width: 0;
    font-size: 0.85rem;
  }
  .who strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .content {
    padding: 28px 36px 60px;
    max-width: 1200px;
    width: 100%;
  }
  .page-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 28px;
  }
  .page-head h1 {
    font-size: 1.6rem;
    font-weight: 650;
  }
  .page-head p {
    margin: 6px 0 0;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 280px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-faint);
  }
  .search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-glow);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 0;
    background: transparent;
    box-shadow: none;
    color: var(--text);
  }
  .search svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .search kbd {
    margin-left: auto;
    font-family: var(--font);
    font-size: 0.72rem;
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
  }
  @media (max-width: 860px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: static;
      height: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
    nav {
      grid-auto-flow: column;
      overflow-x: auto;
    }
    .me,
    .soon {
      display: none;
    }
    .content {
      padding: 20px 16px 48px;
    }
    .search {
      display: none;
    }
  }
</style>
