{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-dam",
  // Our Hono app is the Worker entry: it owns env and ctx, serves /api, then hands other paths to Astro.
  "main": "./src/fetch.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  // No ids: Wrangler provisions these on first deploy, which is what keeps the install one-click.
  "d1_databases": [{ "binding": "DB", "database_name": "cf-dam" }],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "cf-dam-media" }],
  "kv_namespaces": [{ "binding": "CACHE_KV" }],
  // Thumbnails, previews and look-alike fingerprints.
  "images": { "binding": "IMAGES" },
  // AI review: tags, alt text, captions, descriptions for search (Workers AI, billed per use).
  "ai": { "binding": "AI", "remote": true },
  // The sweep: process imported files, run queued AI review, finish Glacier restores.
  "triggers": { "crons": ["* * * * *"] },
  // The fast lane for the same work (packages/api/src/catalog/work.ts); Wrangler makes the queue on
  // deploy. Each message takes a few photos, so a few run at once; failures are left to the sweep.
  "queues": {
    "producers": [{ "binding": "WORK", "queue": "cf-dam-work" }],
    "consumers": [{ "queue": "cf-dam-work", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 1, "max_concurrency": 4 }]
  },
  // Secrets, set with `wrangler secret put` (the Deploy button prompts for them from .dev.vars.example):
  //   BETTER_AUTH_SECRET  signs sessions; 32+ random characters
  //   SETUP_TOKEN         needed once, to create the first administrator
  "observability": { "enabled": true },

  // A second, separate copy for trying changes before they go live: `npm run deploy:staging`. Bindings
  // aren't inherited, so each is named again, with its own resources: staging never sees the real archive.
  // Its search-by-meaning index is cf-dam-staging-meaning (scripts/optional-bindings.mjs).
  "env": {
    "staging": {
      "name": "cf-dam-staging",
      // The pseudo-language (accented, longer English) for spotting untranslated text.
      "vars": { "I18N_PSEUDO": "1" },
      "d1_databases": [{ "binding": "DB", "database_name": "cf-dam-staging" }],
      "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "cf-dam-staging-media" }],
      "kv_namespaces": [{ "binding": "CACHE_KV" }],
      "images": { "binding": "IMAGES" },
      "ai": { "binding": "AI", "remote": true },
      "triggers": { "crons": ["* * * * *"] },
      "queues": {
        "producers": [{ "binding": "WORK", "queue": "cf-dam-staging-work" }],
        "consumers": [{ "queue": "cf-dam-staging-work", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 1, "max_concurrency": 4 }]
      }
    }
  }
}
