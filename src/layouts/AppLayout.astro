---
import { env } from 'cloudflare:workers'
import { alertCount, getPreferences, isClientOnly, preferenceAttributes, pseudoAllowed } from '@cf-dam/api'
import { getT } from '@cf-dam/i18n'
import Base from './Base.astro'
import Logo from '../components/Logo.astro'
import SignOut from '../components/SignOut.svelte'
import LanguageSwitch from '../components/LanguageSwitch.svelte'
import ThemeSwitch from '../components/ThemeSwitch.svelte'

interface Props {
  title: string
  subtitle?: string
  /** Pages of photos (library, a photo, duplicates, the map, an album) use the whole width. */
  wide?: boolean
  /** This page's help article (src/content/help/<help>.md), opened by the ? beside the title. */
  help?: string
}
const { title, subtitle, wide = false, help } = Astro.props
const principal = Astro.locals.principal!
const t = getT(Astro.locals.lang)
const path = Astro.url.pathname

interface NavItem {
  href: string
  label: string
  /** 24×24 stroke paths; tabs inside a group have none. */
  icon?: string
  soon?: string
  needs?: string
  children?: NavItem[]
}
const nav: NavItem[] = [
  { href: '/', label: t('nav.library'), icon: 'M4 5h16v14H4z M4 15l4.5-4.5 4 4 2.5-2.5L20 17' },
  { href: '/albums', label: t('nav.albums'), icon: 'M5 7h14v12H5z M8 4h8' },
  {
    href: '/jobs',
    label: t('nav.clientWork'),
    icon: 'M4 8h16v11H4z M9 8V5h6v3 M4 13h16',
    // Jobs, clients and their galleries are one part of the app, with tabs along the top.
    children: [
      { href: '/jobs', label: t('nav.jobs'), needs: 'clients:manage' },
      { href: '/clients', label: t('nav.clients'), needs: 'clients:manage' },
      { href: '/galleries', label: t('nav.galleries'), needs: 'shares:manage' },
    ],
  },
  { href: '/keywords', label: t('nav.keywords'), icon: 'M3 12V4h8l9 9-8 8z M7.5 7.5h.01', needs: 'assets:read' },
  { href: '/presets', label: t('nav.presets'), icon: 'M6 3h9l4 4v14H6z M14 3v5h5 M9 12h7 M9 16h5', needs: 'assets:read' },
  { href: '/duplicates', label: t('nav.duplicates'), icon: 'M8 8h11v11H8z M5 16V5h11' },
  { href: '/settings/ai', label: t('nav.ai'), icon: 'M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z M18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9z', needs: 'ai:run' },
  { href: '/settings/storage', label: t('nav.storage'), icon: 'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z M4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7 M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3', needs: 'sources:manage' },
  { href: '/sources', label: t('nav.sources'), icon: 'M4 6h16v5H4z M4 13h16v5H4z M7 8.5h.01 M7 15.5h.01', needs: 'sources:manage' },
  { href: '/admin/users', label: t('nav.people'), icon: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M3 20c.8-3.4 3.3-5 6-5s5.2 1.6 6 5 M16 4.5a3.5 3.5 0 0 1 0 6.5 M18 15c1.6.6 2.7 2.2 3 5', needs: 'users:manage' },
  { href: '/admin/activity', label: t('nav.activity'), icon: 'M3 12h4l3-8 4 16 3-8h4', needs: 'activity:read' },
  { href: '/admin/alerts', label: t('nav.alerts'), icon: 'M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z M10 20.5a2 2 0 0 0 4 0', needs: 'alerts:read' },
  { href: '/account', label: t('common.account'), icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21c1-4 4.3-6 8-6s7 2 8 6' },
  { href: '/help', label: t('common.help'), icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6 M12 17h.01' },
]
// A client sees their galleries, their account and their own help, and no archive search.
const client = isClientOnly(principal.roles)
const clientNav: NavItem[] = [
  { href: '/my-galleries', label: t('mine.title'), icon: 'M5 7h14v12H5z M8 4h8' },
  { href: '/account', label: t('common.account'), icon: nav.find((n) => n.href === '/account')!.icon },
  { href: '/help/for-clients', label: t('common.help'), icon: nav.find((n) => n.href === '/help')!.icon },
]
const helpPage = client ? 'for-clients' : help
const preferences = Astro.locals.preferences ?? (await getPreferences(env.DB, principal.userId))
const allowed = (item: NavItem) => !item.needs || principal.permissions.has(item.needs)
// A group shows when any of its pages may be seen, and opens the first of them.
const visible = client
  ? clientNav
  : nav.flatMap((item) => {
      if (!item.children) return allowed(item) ? [item] : []
      const children = item.children.filter(allowed)
      return children.length > 0 ? [{ ...item, href: children[0]!.href, children }] : []
    })
const isActive = (item: NavItem): boolean => (item.children ? item.children.some(isActive) : item.href === '/' ? path === '/' : path.startsWith(item.href))
const section = visible.find((item) => item.children && isActive(item))
// Problems that need someone, for those who see alerts: one small query.
const alerts = principal.permissions.has('alerts:read') ? await alertCount(env.DB).catch(() => 0) : 0
const initials = (principal.name || principal.email)
  .split(/\s+/)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .slice(0, 2)
  .join('')
---
<Base title={title} attributes={preferenceAttributes(preferences)}>
  <a class="skip" href="#main">{t('layout.skip')}</a>
  <div class="shell">
    <aside class="sidebar">
      <a class="brand" href={client ? '/my-galleries' : '/'}><Logo /><span>cf-dam</span></a>
      <nav>
        {visible.map((item) => {
          const active = isActive(item)
          return item.soon ? (
            <span class="nav-item disabled" title={t('nav.comingIn', { phase: item.soon })}>
              <svg viewBox="0 0 24 24"><path d={item.icon} /></svg>
              {item.label}
              <span class="soon">{item.soon}</span>
            </span>
          ) : (
            <a class:list={['nav-item', { active }]} href={item.href} aria-current={active ? 'page' : undefined}>
              <svg viewBox="0 0 24 24"><path d={item.icon} /></svg>
              {item.label}
              {item.href === '/admin/alerts' && alerts > 0 && <span class="count" title={t('nav.alertsOpen', { count: alerts })}>{alerts}</span>}
            </a>
          )
        })}
      </nav>
      <div class="me">
        <span class="avatar">{initials}</span>
        <div class="who">
          <strong>{principal.name || principal.email}</strong>
          <span class="muted">{client ? t('role.client') : principal.roles.map((r) => (['admin', 'editor', 'viewer'].includes(r) ? t(`role.${r}` as 'role.admin') : r)).join(', ')}</span>
        </div>
      </div>
      <div class="row end">
        <LanguageSwitch client:load signedIn pseudo={pseudoAllowed(env as { I18N_PSEUDO?: string })} />
        <ThemeSwitch client:load theme={preferences.theme} />
        <SignOut client:load />
      </div>
    </aside>

    <script is:inline>
      // ⌘K / Ctrl+K focuses search, as in most modern apps.
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault()
          document.getElementById('global-search')?.focus()
        }
      })
    </script>
    <main class:list={["content", { wide }]} id="main" tabindex="-1">
      {section && (
        <nav class="section-tabs" aria-label={section.label}>
          {section.children!.map((tab) => (
            <a class:list={{ on: isActive(tab) }} href={tab.href} aria-current={isActive(tab) ? 'page' : undefined}>{tab.label}</a>
          ))}
        </nav>
      )}
      <header class="page-head">
        <div>
          <h1>
            {title}
            {helpPage && <a class="help-link" href={`/help/${helpPage}`} title={t('layout.helpThisPage')} aria-label={t('layout.helpWith', { page: title })}>?</a>}
          </h1>
          {subtitle && <p class="muted">{subtitle}</p>}
        </div>
        {!client && <form class="search" action="/" method="get" role="search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14z M20 20l-4-4" /></svg>
          <input id="global-search" type="search" name="q" placeholder={t('search.placeholder')} value={Astro.url.searchParams.get('q') ?? ''} aria-label={t('search.placeholder')} />
          <kbd>⌘K</kbd>
        </form>}
      </header>
      <slot />
    </main>
  </div>
</Base>

<style>
  .shell {
    display: grid;
    grid-template-columns: 248px 1fr;
    min-height: 100vh;
  }
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 14px;
    border-right: 1px solid var(--border);
    background: linear-gradient(180deg, var(--bg-elevated), var(--bg));
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 8px 18px;
    color: var(--text);
    font-weight: 650;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    text-decoration: none;
  }
  nav {
    display: grid;
    gap: 2px;
    flex: 1;
    align-content: start;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-weight: 500;
    transition: background 150ms var(--ease), color 150ms var(--ease);
  }
  .nav-item svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  a.nav-item:hover {
    background: var(--surface-hover);
    color: var(--text);
    text-decoration: none;
  }
  .nav-item.active {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .nav-item.disabled {
    opacity: 0.5;
    cursor: default;
  }
  .count {
    margin-left: auto;
    min-width: 20px;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--danger);
    color: var(--bg);
    font-size: 0.72rem;
    font-weight: 650;
    text-align: center;
  }
  .soon {
    margin-left: auto;
    font-size: 0.68rem;
    color: var(--text-faint);
  }
  .me {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 8px;
    border-top: 1px solid var(--border);
  }
  .avatar {
    width: 34px;
    height: 34px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, var(--accent-strong), var(--accent-2));
  }
  .who {
    display: grid;
    min-width: 0;
    font-size: 0.85rem;
  }
  .who strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .content {
    padding: 28px 36px 60px;
    max-width: 1200px;
    width: 100%;
  }
  .content.wide {
    max-width: none;
  }
  .content:focus {
    outline: none;
  }
  .end {
    gap: 6px;
    align-items: center;
  }
  .help-link {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: 8px;
    vertical-align: 0.2em;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
  }
  .help-link:hover {
    color: var(--text);
    border-color: var(--accent);
    text-decoration: none;
  }
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 200;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    background: var(--accent-strong);
    color: #fff;
    font-weight: 600;
  }
  .skip:focus {
    top: 12px;
  }
  .section-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: -8px 0 20px;
    border-bottom: 1px solid var(--border);
  }
  .section-tabs a {
    padding: 8px 14px;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-weight: 500;
  }
  .section-tabs a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .section-tabs a.on {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  .page-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 28px;
  }
  .page-head h1 {
    font-size: 1.6rem;
    font-weight: 650;
  }
  .page-head p {
    margin: 6px 0 0;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 280px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-faint);
  }
  .search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-glow);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 0;
    background: transparent;
    box-shadow: none;
    color: var(--text);
  }
  .search svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .search kbd {
    margin-left: auto;
    font-family: var(--font);
    font-size: 0.72rem;
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
  }
  @media (max-width: 860px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: static;
      height: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
    nav {
      grid-auto-flow: column;
      overflow-x: auto;
    }
    .me,
    .soon {
      display: none;
    }
    .content {
      padding: 20px 16px 48px;
    }
    .search {
      display: none;
    }
  }
</style>
