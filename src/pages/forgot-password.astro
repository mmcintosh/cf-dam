---
/** "Forgot your password?": a reset link by email (plans/PLAN-E-v2.md §4), when email works. */
import { env } from 'cloudflare:workers'
import { getMailSettings, mailReady } from '@cf-dam/api'
import { getT } from '@cf-dam/i18n'
import AuthLayout from '../layouts/AuthLayout.astro'
import ForgotForm from '../components/ForgotForm.svelte'

const t = getT(Astro.locals.lang)
const canReset = mailReady(env as Parameters<typeof mailReady>[0], await getMailSettings(env.DB))
---
<AuthLayout title={t('auth.forgot.title')}>
  {canReset ? (
    <ForgotForm client:load />
  ) : (
    <div class="stack">
      <h2>{t('auth.forgot.title')}</h2>
      <p class="muted">{t('auth.forgot.askAdminLead')}</p>
      <p><a class="btn" href="/login">{t('auth.forgot.back')}</a></p>
    </div>
  )}
</AuthLayout>
