---
/**
 * A client gallery: what the photographer's client sees, without an account (plans/PLAN-P4-v1.md).
 * The data comes from the same functions as /api/public/galleries, so the page and the API agree.
 */
import { env } from 'cloudflare:workers'
import { galleryJson, openGallery, recordEvent } from '@cf-dam/api'
import Base from '../../layouts/Base.astro'
import ClientGallery from '../../components/ClientGallery.svelte'

const token = Astro.params.token ?? ''
const access = await openGallery(env, token, Astro.request)
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
Astro.response.headers.set('Cache-Control', 'private, no-store')

let initial = null
if (access.state === 'open') {
  await recordEvent(env.DB, access.share, { kind: 'open', visitorId: access.visitor?.id })
  initial = await galleryJson(env.DB, access.share, access.visitor, access.member)
}
if (access.state === 'gone') Astro.response.status = 404
if (access.state === 'expired') Astro.response.status = 410
const title = access.state === 'gone' ? 'Gallery not available' : access.share.title
const expiredOn = access.state === 'expired' && access.share.expires_at ? new Date(access.share.expires_at).toLocaleDateString('en', { dateStyle: 'long' }) : null
---
<Base title={title} bare>
  {access.state === 'gone' || access.state === 'expired' ? (
    <main class="notice">
      <h1>{access.state === 'gone' ? 'This gallery is no longer available' : 'This gallery has expired'}</h1>
      <p class="muted">
        {expiredOn ? `It was open until ${expiredOn}. ` : ''}If you still need these photos, ask the photographer who sent you the link.
      </p>
    </main>
  ) : (
    <ClientGallery client:load token={token} title={access.share.title} initial={initial} />
  )}
</Base>

<style>
  .notice {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 12px;
    padding: 32px 16px;
    text-align: center;
    max-width: 520px;
    margin: 0 auto;
  }
  .notice h1 {
    font-size: 1.5rem;
    font-weight: 650;
  }
</style>
