---
import { env } from 'cloudflare:workers'
import { createFormat, getT, type MessageKey } from '@cf-dam/i18n'
import { getJob, jobAlbums, jobShares } from '@cf-dam/api'
import AppLayout from '../../layouts/AppLayout.astro'
import ActivityLog from '../../components/ActivityLog.svelte'
import JobAlbums from '../../components/JobAlbums.svelte'
import JobDetails from '../../components/JobDetails.svelte'
import JobStage from '../../components/JobStage.svelte'

const id = Astro.params.id!
const job = await getJob(env.DB, id)
if (!job) return Astro.redirect('/jobs')
const [albums, galleries] = await Promise.all([jobAlbums(env.DB, id), jobShares(env.DB, id)])
const { results: clients } = await env.DB.prepare('SELECT id, name FROM clients WHERE past_at IS NULL OR id = ? ORDER BY name COLLATE NOCASE LIMIT 2000')
  .bind(job.client.id)
  .all<{ id: string; name: string }>()
const t = getT(Astro.locals.lang)
const fmt = createFormat(Astro.locals.lang)
const day = (d: string | null) => (d ? fmt.date(`${d.slice(0, 10)}T12:00:00Z`) : '—')
const STATUS: Record<string, string> = { active: t('galleries.status.active'), expired: t('galleries.status.expired'), revoked: t('galleries.status.revoked') }
const kind = job.kind === 'other' && job.kindOther ? job.kindOther : t((job.kind === 'other' ? 'job.kind.misc' : `job.kind.${job.kind}`) as MessageKey)
const dates = job.shootStart ? (job.shootEnd && job.shootEnd !== job.shootStart ? `${day(job.shootStart)} – ${day(job.shootEnd)}` : day(job.shootStart)) : ''
const subtitle = [kind, dates, job.place].filter(Boolean).join(' · ')
---
<AppLayout help="jobs" title={job.title} subtitle={subtitle}>
  <div class="row top">
    <a class="btn btn-sm" href="/jobs">← {t('nav.jobs')}</a>
    <a class="btn btn-sm" href={`/clients/${job.client.id}`}>{job.client.name}</a>
  </div>

  <section class="card stack">
    <h2>{t('jobs.stage')}</h2>
    <JobStage client:load jobId={job.id} stage={job.stage} />
    {job.deliveredAt && <p class="muted small">{t('jobs.deliveredOn', { date: day(job.deliveredAt) })}</p>}
  </section>

  <section class="card stack">
    <h2>{t('nav.albums')}</h2>
    <JobAlbums client:load jobId={job.id} initial={albums} hasDates={Boolean(job.shootStart)} />
  </section>

  <section class="card stack">
    <h2>{t('clientsPage.galleries')}</h2>
    {galleries.length === 0 ? (
      <p class="muted">{t('jobs.noGalleries')}</p>
    ) : (
      <div class="scroll">
        <table class="table">
          <thead><tr><th>{t('galleries.link')}</th><th>{t('galleries.album')}</th><th>{t('common.status')}</th><th>{t('galleries.expires')}</th><th>{t('galleries.opens')}</th><th>{t('common.favourites')}</th><th>{t('common.downloads')}</th></tr></thead>
          <tbody>
            {galleries.map((s) => (
              <tr>
                <td><a href={`/galleries/${s.id}`}>{s.name}</a>{s.finalDelivery && <span class="badge badge-ok small">{t('jobs.final')}</span>}</td>
                <td><a href={`/albums/${s.albumId}`}>{s.albumName}</a></td>
                <td><span class:list={['badge', { 'badge-ok': s.status === 'active' }]}>{STATUS[s.status]}</span></td>
                <td class="muted">{s.expiresAt ? fmt.date(s.expiresAt) : t('galleries.never')}</td>
                <td>{s.stats.opens}</td>
                <td>{s.stats.picks}</td>
                <td>{s.stats.downloads}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    <p class="muted small">{t('jobs.galleriesLead')}</p>
  </section>

  <section class="card stack">
    <h2>{t('clientsPage.details')}</h2>
    <JobDetails client:load job={job} clients={clients} />
  </section>

  <section class="card stack">
    <h2>{t('clientsPage.history')}</h2>
    <ActivityLog client:load job={job.id} />
  </section>
</AppLayout>

<style>
  .top {
    gap: 8px;
    margin-bottom: 16px;
  }
  section + section {
    margin-top: 20px;
  }
  h2 {
    font-size: 1.05rem;
    margin: 0;
  }
  .scroll {
    overflow-x: auto;
  }
  .small {
    font-size: 0.85rem;
  }
  .badge.small {
    margin-left: 6px;
  }
</style>
