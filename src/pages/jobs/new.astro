---
import { env } from 'cloudflare:workers'
import { getT } from '@cf-dam/i18n'
import { filterSummary, parseListFilters } from '@cf-dam/api'
import AppLayout from '../../layouts/AppLayout.astro'
import NewJob from '../../components/NewJob.svelte'

// ?client= chooses the client; ?from= carries the Library's query string ("New job from these photos").
const clientId = Astro.url.searchParams.get('client') ?? ''
const from = (Astro.url.searchParams.get('from') ?? '').slice(0, 2000)
const { results: clients } = await env.DB.prepare('SELECT id, name FROM clients WHERE past_at IS NULL OR id = ? ORDER BY name COLLATE NOCASE LIMIT 2000')
  .bind(clientId)
  .all<{ id: string; name: string }>()
let summary: { photos: number; first: string | null; last: string | null } | null = null
if (from) {
  try {
    summary = await filterSummary(env.DB, parseListFilters(Object.fromEntries(new URLSearchParams(from))))
  } catch {
    summary = null // a search by meaning or look-alikes can't make a job: the form says so when sent
  }
}
const t = getT(Astro.locals.lang)
---
<AppLayout help="jobs" title={t('jobs.new')} subtitle={from ? t('jobs.newFromLead') : t('jobs.newLead')}>
  <div class="row top"><a class="btn btn-sm" href="/jobs">← {t('nav.jobs')}</a>{from && <a class="btn btn-sm" href={`/?${from}`}>← {t('nav.library')}</a>}</div>
  <NewJob client:load clients={clients} clientId={clientId} from={from} summary={summary} />
</AppLayout>

<style>
  .top {
    gap: 8px;
    margin-bottom: 16px;
  }
</style>
