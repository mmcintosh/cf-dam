---
import { env } from 'cloudflare:workers'
import { facets as loadFacets, getAiSettings, listAssets, listConnections, parseListFilters, timeline as loadTimeline } from '@cf-dam/api'
import AppLayout from '../layouts/AppLayout.astro'
import Facets from '../components/Facets.astro'
import Library from '../components/Library.svelte'
import Timeline from '../components/Timeline.astro'
import Uploader from '../components/Uploader.svelte'

const principal = Astro.locals.principal!
const params = new URL(Astro.url).searchParams
params.delete('offset')
params.delete('limit')
const query = Object.fromEntries(params)
const filters = parseListFilters(query)
const PAGE = 100

const canRead = principal.permissions.has('assets:read')
const canUpload = principal.permissions.has('assets:upload')
const [{ assets, total }, facets, months] = canRead
  ? await Promise.all([listAssets(env.DB, { ...filters, limit: PAGE, offset: 0 }), loadFacets(env.DB, filters), loadTimeline(env.DB, filters)])
  : [{ assets: [], total: 0 }, null, []]
const connections = canUpload
  ? (await listConnections(env.DB)).map((c) => ({ id: c.id, name: c.name, storageClasses: c.storageClasses, defaultClass: c.defaultClass, isDefault: c.isDefault }))
  : []
const canRunAi = principal.permissions.has('ai:run') && Boolean(env.AI) && (await getAiSettings(env.DB)).enabled
const filtered = [...params.keys()].some((k) => k !== 'sort')
const sort = filters.sort
const sortLink = (value: 'captured' | 'added') => {
  const next = new URLSearchParams(params)
  value === 'captured' ? next.delete('sort') : next.set('sort', value)
  const s = next.toString()
  return s ? `/?${s}` : '/'
}
const subtitle = `${total.toLocaleString()} ${total === 1 ? 'item' : 'items'}${filtered ? ' match' : ''}`
---
<AppLayout title="Library" subtitle={subtitle}>
  {total === 0 && !filtered ? (
    <div class="empty stack">
      <div class="card hero">
        <h2>Your archive starts here</h2>
        <p class="muted">
          Drop in a few photos. Each one is read for camera, lens, date and place, given a thumbnail and a preview, and made
          searchable. Originals go wherever you choose, from hot R2 to S3 Glacier Deep Archive.
        </p>
      </div>
      {canUpload && <Uploader client:load connections={connections} open />}
    </div>
  ) : (
    <div class="library">
      {facets && <Facets facets={facets} params={params} />}
      <section class="main">
        <Timeline months={months} params={params} />
        <div class="toolbar row">
          <nav class="sort" aria-label="Sort">
            <a href={sortLink('captured')} class:list={{ on: sort === 'captured' }}>Date taken</a>
            <a href={sortLink('added')} class:list={{ on: sort === 'added' }}>Recently added</a>
          </nav>
          <a class="btn btn-sm" href={`/map${params.toString() ? `?${params}` : ''}`}>Map</a>
          <span class="hint muted">⌘-click or shift-click to select · 1–5 rate · P pick · X reject</span>
          <span class="spacer"></span>
          {canUpload && <Uploader client:idle connections={connections} />}
        </div>
        {assets.length > 0 ? (
          <Library
            client:load
            initial={assets}
            initialTotal={total}
            query={params.toString()}
            pageSize={PAGE}
            canEdit={principal.permissions.has('assets:edit')}
            canDelete={principal.permissions.has('assets:delete')}
            canRunAi={canRunAi}
          />
        ) : (
          <p class="muted">Nothing matches. Remove a filter or try fewer words.</p>
        )}
      </section>
    </div>
  )}
</AppLayout>

<style>
  .hero h2 {
    font-size: 1.4rem;
  }
  .hero p {
    max-width: 640px;
    margin: 10px 0 0;
  }
  .library {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .library :global(.facets) {
    position: sticky;
    top: 20px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
  }
  .toolbar {
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }
  .toolbar :global(.uploader) {
    flex-basis: 100%;
    order: 10;
  }
  .spacer {
    flex: 1;
  }
  .hint {
    font-size: 0.78rem;
    align-self: center;
  }
  .sort {
    display: flex;
    gap: 4px;
    padding: 3px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .sort a {
    padding: 5px 12px;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 550;
  }
  .sort a:hover {
    text-decoration: none;
    color: var(--text);
  }
  .sort a.on {
    background: var(--surface-strong);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  @media (max-width: 980px) {
    .library {
      grid-template-columns: 1fr;
    }
    .library :global(.facets) {
      position: static;
      max-height: none;
    }
    .hint {
      display: none;
    }
  }
</style>
