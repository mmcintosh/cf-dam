---
import { env } from 'cloudflare:workers'
import { getWatermark, listShares } from '@cf-dam/api'
import AppLayout from '../../layouts/AppLayout.astro'
import WatermarkSettings from '../../components/WatermarkSettings.svelte'

const shares = await listShares(env.DB)
const watermark = await getWatermark(env.DB)
const sample = await env.DB.prepare(
  "SELECT r.asset_id FROM renditions r JOIN assets a ON a.id = r.asset_id AND a.deleted_at IS NULL WHERE r.name = 'preview' AND a.width >= a.height ORDER BY a.created_at DESC LIMIT 1",
).first<{ asset_id: string }>()
const live = shares.filter((s) => s.status !== 'revoked')
const fmt = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString('en', { dateStyle: 'medium' }) : '—')
const STATUS: Record<string, string> = { active: 'Open', expired: 'Expired', revoked: 'Revoked' }
---
<AppLayout help="client-galleries" title="Client galleries" subtitle="Albums shared with clients by link. Make a link from an album's page.">
  <section class="card">
    {live.length === 0 ? (
      <p class="muted">No links yet. Open an <a href="/albums">album</a> and use <strong>New link</strong> to share it with a client.</p>
    ) : (
      <div class="scroll">
        <table class="table">
          <thead><tr><th>Link</th><th>Album</th><th>Status</th><th>Opens</th><th>Picking</th><th>Favourites</th><th>Downloads</th><th>Last opened</th></tr></thead>
          <tbody>
            {live.map((s) => (
              <tr>
                <td><a href={`/galleries/${s.id}`}>{s.name}</a></td>
                <td><a href={`/albums/${s.albumId}`}>{s.albumName}</a></td>
                <td><span class:list={['badge', { 'badge-ok': s.status === 'active' }]}>{STATUS[s.status]}</span></td>
                <td>{s.stats.opens}</td>
                <td>{s.stats.visitors}</td>
                <td>{s.stats.picks}</td>
                <td>{s.stats.downloads}</td>
                <td class="muted">{fmt(s.stats.lastOpenedAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <section class="card">
    <h2>Watermark</h2>
    <p class="lead">Used by every link that has the watermark turned on, for what clients see and the JPEGs they download. Originals are never watermarked.</p>
    <WatermarkSettings client:load initial={watermark} sampleAssetId={sample?.asset_id ?? null} />
  </section>
</AppLayout>

<style>
  section + section {
    margin-top: 24px;
  }
  .scroll {
    overflow-x: auto;
  }
</style>
