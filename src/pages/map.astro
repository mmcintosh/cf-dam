---
import AppLayout from '../layouts/AppLayout.astro'
import { getT } from '@cf-dam/i18n'
import PhotoMap from '../components/PhotoMap.svelte'

const params = new URL(Astro.url).searchParams
params.delete('offset')
const placeId = params.get('place')
params.delete('place')
const canEdit = Astro.locals.principal!.permissions.has('assets:edit')
const t = getT(Astro.locals.lang)
---
<AppLayout help="library" wide title={t('map.title')} subtitle={t('map.subtitle')}>
  <PhotoMap client:only="svelte" query={params.toString()} placeId={placeId} canEdit={canEdit} />
</AppLayout>
