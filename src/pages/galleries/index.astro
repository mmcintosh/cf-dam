---
import { env } from 'cloudflare:workers'
import { createFormat, getT } from '@cf-dam/i18n'
import { getWatermark, listShares } from '@cf-dam/api'
import AppLayout from '../../layouts/AppLayout.astro'
import WatermarkSettings from '../../components/WatermarkSettings.svelte'

const shares = await listShares(env.DB)
const watermark = await getWatermark(env.DB)
const sample = await env.DB.prepare(
  "SELECT r.asset_id FROM renditions r JOIN assets a ON a.id = r.asset_id AND a.deleted_at IS NULL WHERE r.name = 'preview' AND a.width >= a.height ORDER BY a.created_at DESC LIMIT 1",
).first<{ asset_id: string }>()
const live = shares.filter((s) => s.status !== 'revoked')
const t = getT(Astro.locals.lang)
const fmt = (iso: string | null) => (iso ? createFormat(Astro.locals.lang).date(iso) : '—')
const STATUS: Record<string, string> = { active: t('galleries.status.active'), expired: t('galleries.status.expired'), revoked: t('galleries.status.revoked') }
---
<AppLayout help="client-galleries" title={t('nav.galleries')} subtitle={t('galleries.subtitle')}>
  <section class="card">
    {live.length === 0 ? (
      <p class="muted">{t('galleries.none')} <a href="/albums">{t('albums.title')}</a></p>
    ) : (
      <div class="scroll">
        <table class="table">
          <thead><tr><th>{t('galleries.link')}</th><th>{t('galleries.album')}</th><th>{t('common.status')}</th><th>{t('galleries.opens')}</th><th>{t('galleries.picking')}</th><th>{t('common.favourites')}</th><th>{t('common.downloads')}</th><th>{t('galleries.lastOpened')}</th></tr></thead>
          <tbody>
            {live.map((s) => (
              <tr>
                <td><a href={`/galleries/${s.id}`}>{s.name}</a></td>
                <td><a href={`/albums/${s.albumId}`}>{s.albumName}</a></td>
                <td><span class:list={['badge', { 'badge-ok': s.status === 'active' }]}>{STATUS[s.status]}</span></td>
                <td>{s.stats.opens}</td>
                <td>{s.stats.visitors}</td>
                <td>{s.stats.picks}</td>
                <td>{s.stats.downloads}</td>
                <td class="muted">{fmt(s.stats.lastOpenedAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <section class="card">
    <h2>{t('share.watermark')}</h2>
    <p class="lead">{t('galleries.watermarkLead')}</p>
    <WatermarkSettings client:load initial={watermark} sampleAssetId={sample?.asset_id ?? null} />
  </section>
</AppLayout>

<style>
  section + section {
    margin-top: 24px;
  }
  .scroll {
    overflow-x: auto;
  }
</style>
