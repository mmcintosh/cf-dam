---
import AppLayout from '../../layouts/AppLayout.astro'
import { getT } from '@cf-dam/i18n'
import UsersAdmin from '../../components/UsersAdmin.svelte'

const principal = Astro.locals.principal!
const t = getT(Astro.locals.lang)
---
<AppLayout help="people-and-roles" title={t('people.title')} subtitle={t('people.subtitle')}>
  <UsersAdmin client:load selfId={principal.userId} />
</AppLayout>
