---
import { getCollection } from 'astro:content'
import AppLayout from '../../layouts/AppLayout.astro'
import HelpSearch from '../../components/HelpSearch.svelte'
import { HELP_SECTIONS } from '../../content.config'

const articles = (await getCollection('help')).sort((a, b) => a.data.order - b.data.order)
const index = articles.map((a) => ({ slug: a.id, title: a.data.title, summary: a.data.summary, section: a.data.section, text: a.body ?? '' }))
---
<AppLayout title="Help" subtitle="How cf-dam works, and how to do each thing in it. Every page has a ? that opens its own part.">
  <HelpSearch client:load articles={index} sections={[...HELP_SECTIONS]} />
</AppLayout>
