---
import { env } from 'cloudflare:workers'
import { getT } from '@cf-dam/i18n'
import { getShare, namesToCheck, sharePeople, shareDownloads, sharePicks, shareVisitors } from '@cf-dam/api'
import AppLayout from '../../layouts/AppLayout.astro'
import SharePicks from '../../components/SharePicks.svelte'
import GalleryPeople from '../../components/GalleryPeople.svelte'
import NamesToCheck from '../../components/NamesToCheck.svelte'

const id = Astro.params.id!
const share = await getShare(env.DB, id)
if (!share) return new Response('Not found', { status: 404 })
const [visitors, picks, downloads] = await Promise.all([shareVisitors(env.DB, id), sharePicks(env.DB, id), shareDownloads(env.DB, id)])
const { results: photos } = await env.DB.prepare(
  `SELECT a.id, a.filename, EXISTS (SELECT 1 FROM renditions r WHERE r.asset_id = a.id AND r.name = 'thumb') AS has_thumb
   FROM album_items ai JOIN assets a ON a.id = ai.asset_id AND a.deleted_at IS NULL
   WHERE ai.album_id = ? ORDER BY ai.position, ai.added_at LIMIT 2000`,
)
  .bind(share.albumId)
  .all<{ id: string; filename: string; has_thumb: number }>()
// Who the gallery shows its client's own people: names and groups, so for those who manage people.
const managesPeople = Astro.locals.principal!.permissions.has('people:manage')
const canPeople = managesPeople && share.status !== 'revoked'
const row = managesPeople
  ? (await env.DB.prepare('SELECT id, album_id, people_shown, children_named, suggestions_on FROM shares WHERE id = ?').bind(id).first<{ id: string; album_id: string; people_shown: number; children_named: number; suggestions_on: number }>())!
  : null
const people = canPeople ? await sharePeople(env.DB, row!) : null
// Names the couple suggested (catalog/name-suggestions.ts): on closed galleries too, as deciding is the team's work.
const names = row ? await namesToCheck(env.DB, row) : null
const t = getT(Astro.locals.lang)
const STATUS: Record<string, string> = { active: t('galleries.status.active'), expired: t('galleries.status.expired'), revoked: t('galleries.status.revoked') }
const link = `${Astro.url.origin}/s/${share.token}`
---
<AppLayout help="client-galleries" title={share.name} subtitle={t('galleries.detailSubtitle', { title: share.title, status: STATUS[share.status] ?? share.status, opens: t('share.opens', { count: share.stats.opens }), downloads: share.stats.downloads })}>
  <section class="card stack">
    <div class="row">
      <a class="btn btn-sm" href={`/albums/${share.albumId}`}>← {share.albumName}</a>
      {share.status !== 'revoked' && <a class="btn btn-sm" href={link} target="_blank" rel="noopener">{t('galleries.asClient')}</a>}
    </div>
    <h2>{t('galleries.whoPicked')}</h2>
    <SharePicks
      client:load
      shareId={share.id}
      photos={photos.map((p) => ({ id: p.id, filename: p.filename, hasThumb: p.has_thumb === 1 }))}
      visitors={visitors}
      picks={picks}
      downloads={downloads}
    />
  </section>
  {names && (names.count > 0 || row!.suggestions_on === 1) && (
    <section class="card stack people" id="names">
      <h2>{t('namesToCheck.title')}</h2>
      <NamesToCheck client:load shareId={share.id} initial={names} />
    </section>
  )}
  {people && (
    <section class="card stack people" id="people">
      <h2>{t('galleryPeople.title')}</h2>
      <GalleryPeople client:load shareId={share.id} initial={people} />
    </section>
  )}
</AppLayout>

<style>
  .people {
    margin-top: 20px;
  }
  h2 {
    font-size: 1.05rem;
    margin: 0;
  }
</style>
