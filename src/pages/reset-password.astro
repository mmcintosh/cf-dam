---
/** A password reset link from an email (plans/PLAN-E-v2.md §4): choose a new password. */
import { getT } from '@cf-dam/i18n'
import AuthLayout from '../layouts/AuthLayout.astro'
import ResetForm from '../components/ResetForm.svelte'

const token = (Astro.url.searchParams.get('token') ?? '').slice(0, 200)
const t = getT(Astro.locals.lang)
// The token is in the address: never sent on as a referrer, never cached or indexed.
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
Astro.response.headers.set('Cache-Control', 'private, no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---
<AuthLayout title={t('auth.reset.title')}>
  <ResetForm client:load {token} signedIn={Boolean(Astro.locals.principal)} />
</AuthLayout>
