---
import { env } from 'cloudflare:workers'
import AuthLayout from '../layouts/AuthLayout.astro'
import { currentRestoreView } from '@cf-dam/api'
import SetupForm from '../components/SetupForm.svelte'
import { getT } from '@cf-dam/i18n'

const local = ['localhost', '127.0.0.1', '[::1]'].includes(Astro.url.hostname)
const tokenConfigured = Boolean(env.SETUP_TOKEN)
const restore = await currentRestoreView(env.DB)
const t = getT(Astro.locals.lang)
---
<AuthLayout title={t('setup.pageTitle')}>
  <SetupForm client:load tokenRequired={tokenConfigured || !local} blocked={!tokenConfigured && !local} {restore} />
</AuthLayout>
