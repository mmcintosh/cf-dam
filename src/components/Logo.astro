---
interface Props {
  size?: number
}
const { size = 28 } = Astro.props
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--accent-strong)" />
      <stop offset="1" stop-color="var(--accent-2)" />
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill="url(#logo-g)" />
  <g fill="none" stroke="#fff" stroke-width="1.6" stroke-linejoin="round" opacity="0.95">
    <circle cx="16" cy="16" r="8.5" />
    <path d="M16 7.5 L20.5 15 M24.5 16 L16.5 20.5 M20 23.5 L11.5 20 M7.5 16 L12 11 M11 8.9 L19.8 8.9" />
  </g>
</svg>
