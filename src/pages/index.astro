---
import { env } from 'cloudflare:workers'
import { displayLabelNames } from '../lib/label-names'
import { createFormat, getT } from '@cf-dam/i18n'
import { DEFAULT_LABEL_NAMES, facets as loadFacets, getAiSettings, getAsset, getConnection, getLabelNames, getStats, listPresets, listSavedSearches, listAssets, listConnections, meaningAvailable, parseListFilters, resolveNear, timeline as loadTimeline } from '@cf-dam/api'
import AppLayout from '../layouts/AppLayout.astro'
import Facets from '../components/Facets.astro'
import Library from '../components/Library.svelte'
import Timeline from '../components/Timeline.astro'
import Uploader from '../components/Uploader.svelte'

const principal = Astro.locals.principal!
const params = new URL(Astro.url).searchParams
params.delete('offset')
params.delete('limit')
const query = Object.fromEntries(params)
const canSearchMeaning = principal.permissions.has('assets:read') && (await meaningAvailable(env))
// A search by meaning (words, or "more like" a photo) is looked up first: the rest narrows and orders by it.
const filters = canSearchMeaning ? await resolveNear(env, parseListFilters(query)) : parseListFilters(query)
const likeName = filters.like ? (await getAsset(env.DB, filters.like))?.filename : undefined
const byWords = (words: string, key: 'q' | 'meaning') => `/?${new URLSearchParams({ [key]: words })}`
const PAGE = 100

const canRead = principal.permissions.has('assets:read')
const canUpload = principal.permissions.has('assets:upload')
const [{ assets, total, totalExact }, facets, months] = canRead
  ? await Promise.all([listAssets(env.DB, { ...filters, limit: PAGE, offset: 0 }), loadFacets(env.DB, filters), loadTimeline(env.DB, filters)])
  : [{ assets: [], total: 0, totalExact: true }, null, []]
const connections = canUpload
  ? (await listConnections(env.DB)).map((c) => ({ id: c.id, name: c.name, storageClasses: c.storageClasses, defaultClass: c.defaultClass, isDefault: c.isDefault }))
  : []
// Only for people who may see the library: saved searches count photos, presets carry IPTC text,
// and the "stored on" name is a connection's.
const [labelNames, savedSearches, presets, storedOn] = canRead
  ? await Promise.all([
      getLabelNames(env.DB),
      listSavedSearches(env.DB),
      listPresets(env.DB),
      params.get('on') ? getConnection(env.DB, params.get('on')!) : null,
    ])
  : [DEFAULT_LABEL_NAMES, [], [], null]
const canRunAi = principal.permissions.has('ai:run') && Boolean(env.AI) && (await getAiSettings(env.DB)).enabled
const filtered = [...params.keys()].some((k) => k !== 'sort')
const sort = filters.sort
const sortLink = (value: 'captured' | 'added') => {
  const next = new URLSearchParams(params)
  value === 'captured' ? next.delete('sort') : next.set('sort', value)
  const s = next.toString()
  return s ? `/?${s}` : '/'
}
// The whole archive's count comes from the sweep's snapshot once the live count stops at 10,000.
const archiveTotal = !filtered && !totalExact ? (await getStats(env.DB))?.photos : undefined
const t = getT(Astro.locals.lang)
const fmt = createFormat(Astro.locals.lang)
const subtitle = archiveTotal
  ? t('common.items', { count: archiveTotal })
  : !totalExact
    ? t(filtered ? 'libpage.matchMore' : 'libpage.itemsMore', { count: fmt.number(total) })
    : t(filtered ? 'libpage.match' : 'common.items', { count: total })
/** A sentence with one part in bold, wherever the language puts it. */
const bold = (text: string) => text.split('\u0000') as [string, string?]
---
<AppLayout help="library" title={t('nav.library')} subtitle={subtitle} wide>
  {total === 0 && !filtered ? (
    <div class="empty stack">
      <div class="card hero">
        <h2>{t('libpage.empty.title')}</h2>
        <p class="muted">{t('libpage.empty.lead')}</p>
      </div>
      {canUpload && <Uploader client:load connections={connections} open />}
    </div>
  ) : (
    <div class="library">
      {facets && <Facets facets={facets} params={params} labelNames={displayLabelNames(labelNames, t)} savedSearches={savedSearches} canSave={principal.permissions.has('assets:edit')} storedOnName={storedOn?.name} />}
      <section class="main">
        <Timeline months={months} params={params} />
        {(filters.meaning || filters.like) && (
          <p class="meaning row">
            <span>
              {filters.like
                ? (() => { const [a, b] = bold(t('libpage.like', { name: '\u0000' })); return <>{a}<strong>{likeName ?? t('libpage.likeThis')}</strong>{b}</> })()
                : (() => { const [a, b] = bold(t('libpage.meaning', { words: '\u0000' })); return <>{a}<strong>“{filters.meaning}”</strong>{b}</> })()}
              {!canSearchMeaning && ` ${t('libpage.meaningOff')}`}
            </span>
            {filters.meaning && <a href={byWords(filters.meaning, 'q')}>{t('libpage.searchWords')}</a>}
          </p>
        )}
        {filters.q && canSearchMeaning && !filters.meaning && (
          <p class="meaning row">
            <span class="muted">{t('libpage.nobodyWrote')}</span>
            <a href={byWords(filters.q, 'meaning')}>{t('libpage.searchMeaning')}</a>
          </p>
        )}
        <div class="toolbar row">
          <nav class="sort" aria-label={t('libpage.sort')}>
            <a href={sortLink('captured')} class:list={{ on: sort === 'captured' }}>{t('libpage.dateTaken')}</a>
            <a href={sortLink('added')} class:list={{ on: sort === 'added' }}>{t('libpage.recentlyAdded')}</a>
          </nav>
          <a class="btn btn-sm" href={`/map${params.toString() ? `?${params}` : ''}`}>{t('libpage.map')}</a>
          <span class="hint muted">{t('libpage.hint')}</span>
          <span class="spacer"></span>
          {canUpload && <Uploader client:idle connections={connections} />}
        </div>
        {assets.length > 0 ? (
          <Library
            client:load
            initial={assets}
            initialTotal={total}
            initialTotalExact={totalExact}
            query={params.toString()}
            pageSize={PAGE}
            canEdit={principal.permissions.has('assets:edit')}
            canDelete={principal.permissions.has('assets:delete')}
            canRunAi={canRunAi}
            canShare={principal.permissions.has('shares:manage')}
            labelNames={displayLabelNames(labelNames, t)}
            presets={presets.map((p) => ({ id: p.id, name: p.name }))}
          />
        ) : (
          <p class="muted">{t('libpage.nothing')}</p>
        )}
      </section>
    </div>
  )}
</AppLayout>

<style>
  .hero h2 {
    font-size: 1.4rem;
  }
  .hero p {
    max-width: 640px;
    margin: 10px 0 0;
  }
  .library {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .library :global(.facets) {
    position: sticky;
    top: 20px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
  }
  .meaning {
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
    margin: 0 0 12px;
  }
  .toolbar {
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }
  .toolbar :global(.uploader) {
    flex-basis: 100%;
    order: 10;
  }
  .spacer {
    flex: 1;
  }
  .hint {
    font-size: 0.78rem;
    align-self: center;
  }
  .sort {
    display: flex;
    gap: 4px;
    padding: 3px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .sort a {
    padding: 5px 12px;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 550;
  }
  .sort a:hover {
    text-decoration: none;
    color: var(--text);
  }
  .sort a.on {
    background: var(--surface-strong);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  @media (max-width: 980px) {
    .library {
      grid-template-columns: 1fr;
    }
    .library :global(.facets) {
      position: static;
      max-height: none;
    }
    .hint {
      display: none;
    }
  }
</style>
