---
import AppLayout from '../../layouts/AppLayout.astro'
import { getT } from '@cf-dam/i18n'
import Connections from '../../components/Connections.svelte'
import BackupSettings from '../../components/BackupSettings.svelte'
import StorageChecks from '../../components/StorageChecks.svelte'
import PreviewHealth from '../../components/PreviewHealth.svelte'
import ImagesUsage from '../../components/ImagesUsage.svelte'
import ArchiveJobsSettings from '../../components/ArchiveJobsSettings.svelte'
const t = getT(Astro.locals.lang)
---
<AppLayout help="storage" title={t('nav.storage')} subtitle={t('storagePage.subtitle')}>
  <div class="stack">
    <section class="stack">
      <div>
        <h2>{t('storagePage.connectionsTitle')}</h2>
        <p class="muted">{t('storagePage.connectionsLead')}</p>
      </div>
      <Connections client:load />
    </section>
    <section class="stack">
      <h2>{t('storagePage.archivingTitle')}</h2>
      <div id="archive-jobs"><ArchiveJobsSettings client:load /></div>
      <div id="backups"><BackupSettings client:load /></div>
    </section>
    <section class="stack">
      <h2>{t('storagePage.checksTitle')}</h2>
      <StorageChecks client:load />
      <PreviewHealth client:load />
    </section>
    <ImagesUsage client:load />
  </div>
</AppLayout>

<style>
  section > h2,
  section > div > h2 {
    font-size: 1.2rem;
    margin: 12px 0 0;
  }
</style>
