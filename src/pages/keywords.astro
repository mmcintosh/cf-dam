---
import { env } from 'cloudflare:workers'
import { getLabelNames, keywordTree } from '@cf-dam/api'
import AppLayout from '../layouts/AppLayout.astro'
import KeywordManager from '../components/KeywordManager.svelte'

const principal = Astro.locals.principal!
const [keywords, labelNames] = await Promise.all([keywordTree(env.DB), getLabelNames(env.DB)])
---
<AppLayout help="keywords" title="Keywords" subtitle={`${keywords.length.toLocaleString()} keywords. Organise them into a tree, as in Lightroom.`}>
  <KeywordManager
    client:load
    initial={keywords}
    labelNames={labelNames}
    canEdit={principal.permissions.has('assets:edit')}
    canManageLabels={principal.permissions.has('settings:manage')}
  />
</AppLayout>
