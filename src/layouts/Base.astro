---
import '../styles/global.css'
interface Props {
  title: string
  /** Client galleries: the page is the photographer's, so no product name in the title, and no indexing. */
  bare?: boolean
}
const { title, bare = false } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    {bare && <meta name="robots" content="noindex, nofollow" />}
    {bare && <meta name="referrer" content="no-referrer" />}
    <title>{bare ? title : `${title} · cf-dam`}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
