---
/** The filter sidebar: every facet with counts, as plain links, so each view has its own URL. */
import { COUNT_CAP, normalizeQuery, type Facets, type FacetValue, type LabelNames, type SavedSearch } from '@cf-dam/api'
import KeywordTree from './KeywordTree.astro'
import SaveSearch from './SaveSearch.svelte'
import { createFormat, getT, type MessageKey } from '@cf-dam/i18n'

interface Props {
  facets: Facets
  params: URLSearchParams
  labelNames: LabelNames
  savedSearches: SavedSearch[]
  canSave: boolean
  /** Display name for the `on` filter (a NAS agent's or bucket's name rather than its id). */
  storedOnName?: string | null
}
const { facets, params, labelNames, savedSearches, canSave, storedOnName } = Astro.props
const current = normalizeQuery(params.toString())
const alreadySaved = savedSearches.some((s) => s.query === current)

const link = (changes: Record<string, string | null>) => {
  const next = new URLSearchParams(params)
  next.delete('offset')
  for (const [k, v] of Object.entries(changes)) (v === null ? next.delete(k) : next.set(k, v))
  if (changes.year !== undefined) next.delete('month')
  const s = next.toString()
  return s ? `/?${s}` : '/'
}

const t = getT(Astro.locals.lang)
const LABELS: Record<string, Record<string, string>> = {
  flag: { pick: t('facets.flag.pick'), reject: t('facets.flag.reject'), none: t('facets.flag.none') },
  type: { photo: t('facets.type.photo'), raw: t('facets.type.raw'), video: t('facets.type.video'), other: t('facets.type.otherFiles') },
  orientation: { landscape: t('facets.orientation.landscape'), portrait: t('facets.orientation.portrait'), square: t('facets.orientation.square') },
  tier: { nas: t('facets.tier.nas'), hot: t('facets.tier.hot'), warm: t('facets.tier.warm'), cold: t('facets.tier.cold'), deep: t('facets.tier.deep') },
  year: { undated: t('facets.undated') },
  label: { ...labelNames, none: t('facets.noLabel') },
  missing: { '1': t('facets.missing') },
  on: storedOnName && params.get('on') ? { [params.get('on')!]: storedOnName } : {},
  kw: Object.fromEntries(facets.tag.map((k) => [k.id, k.path])),
  gps: { some: t('facets.gps.some'), none: t('facets.gps.none') },
}
const label = (facet: string, value: string) => LABELS[facet]?.[value] ?? value

// Ratings filter "at least N stars", so show cumulative counts (or none, when too many match to count).
const ratingCounts = (() => {
  const uncounted = facets.rating.some((r) => r.count === null)
  const exact = new Map(facets.rating.map((r) => [Number(r.value), r.count ?? 0]))
  let running = 0
  let seen = false
  const out: { stars: number; count: number | null }[] = []
  for (let stars = 5; stars >= 1; stars--) {
    running += exact.get(stars) ?? 0
    seen ||= exact.has(stars)
    if (running > 0 || (uncounted && seen)) out.push({ stars, count: uncounted ? null : running })
  }
  return out
})()
// Some facets go uncounted when too many photos match to count them quickly (FACET_LIVE_MAX).
const uncounted = Object.values(facets).some((values) => (values as { count: number | null }[]).some((v) => v.count === null))

const active: { key: string; text: string }[] = []
const CHIPS: [string, MessageKey | null][] = [['q', 'facets.search'], ['tag', 'facets.tag'], ['kw', 'facets.keyword'], ['camera', 'facets.camera'], ['lens', 'facets.lens'], ['year', 'facets.year'], ['month', 'facets.month'], ['rating', 'facets.rating'], ['flag', null], ['label', 'facets.label'], ['country', 'facets.country'], ['city', 'facets.city'], ['creator', 'facets.creator'], ['missing', null], ['on', 'facets.storedOn'], ['gps', null], ['orientation', null], ['type', null], ['tier', null]]
for (const [key, prefix] of CHIPS) {
  const value = params.get(key)
  if (!value) continue
  const shown = key === 'rating' ? t('facets.andUp', { stars: '★'.repeat(Number(value)) }) : label(key, value)
  active.push({ key, text: prefix ? t('facets.chip', { name: t(prefix), value: shown }) : shown })
}

const sections: { key: string; title: string; values: FacetValue[]; open: boolean }[] = [
  { key: 'type', title: t('facets.type'), values: facets.type, open: true },
  { key: 'flag', title: t('facets.flag'), values: facets.flag, open: true },
  { key: 'tier', title: t('facets.storage'), values: facets.tier, open: true },
  { key: 'orientation', title: t('facets.orientation'), values: facets.orientation, open: false },
  { key: 'camera', title: t('facets.camera'), values: facets.camera, open: false },
  { key: 'lens', title: t('facets.lens'), values: facets.lens, open: false },
  { key: 'label', title: t('facets.label'), values: facets.label, open: true },
  { key: 'country', title: t('facets.country'), values: facets.country, open: false },
  { key: 'city', title: t('facets.city'), values: facets.city, open: false },
  { key: 'creator', title: t('facets.creator'), values: facets.creator, open: false },
]
// Most used first; past KEYWORDS_SHOWN they wait behind "Show all", and the box finds any of them.
const KEYWORDS_SHOWN = 15
const rootKeywords = facets.tag
  .filter((k) => k.parentId === null || !facets.tag.some((p) => p.id === k.parentId))
  .sort((a, b) => (b.count ?? 0) - (a.count ?? 0))
---
<aside class="facets" aria-label={t('facets.filters')}>
  {active.length > 0 && (
    <div class="active">
      {active.map((chip) => (
        <a class="chip" href={link({ [chip.key]: null })} title={t('facets.remove')}>{chip.text} <span aria-hidden="true">✕</span></a>
      ))}
      {active.length > 1 && <a class="clear" href="/">{t('facets.clearAll')}</a>}
      {canSave && current && current !== 'sort=added' && !alreadySaved && <SaveSearch client:idle query={current} />}
    </div>
  )}
  {uncounted && (
    <p class="uncounted">{t('facets.uncounted')}</p>
  )}

  {savedSearches.length > 0 && (
    <details open>
      <summary>{t('facets.saved')}</summary>
      <ul class="values">
        {savedSearches.map((s) => (
          <li><a href={`/?${s.query}`} class:list={{ on: s.query === current }}><span>{s.name}</span><span class="count">{s.count > COUNT_CAP ? `${createFormat(Astro.locals.lang).number(COUNT_CAP)}+` : s.count}</span></a></li>
        ))}
      </ul>
    </details>
  )}

  <details open>
    <summary>{t('facets.year')}</summary>
    <ul class="values">
      {facets.year.map((y) => (
        <li><a href={link({ year: params.get('year') === y.value ? null : y.value })} class:list={{ on: params.get('year') === y.value }}><span>{label('year', y.value)}</span><span class="count">{y.count}</span></a></li>
      ))}
    </ul>
  </details>

  {ratingCounts.length > 0 && (
    <details open>
      <summary>{t('facets.rating')}</summary>
      <ul class="values">
        {ratingCounts.map((r) => (
          <li><a href={link({ rating: params.get('rating') === String(r.stars) ? null : String(r.stars) })} class:list={{ on: params.get('rating') === String(r.stars) }}><span class="stars">{r.stars < 5 ? t('facets.andUp', { stars: '★'.repeat(r.stars) }) : '★'.repeat(r.stars)}</span><span class="count">{r.count}</span></a></li>
        ))}
      </ul>
    </details>
  )}

  {sections.filter((s) => s.values.length > 0).map((section) => (
    <details open={section.open || params.has(section.key)}>
      <summary>{section.title}</summary>
      <ul class="values">
        {section.values.slice(0, 12).map((v) => (
          <li>
            <a href={link({ [section.key]: params.get(section.key) === v.value ? null : v.value })} class:list={{ on: params.get(section.key) === v.value }}>
              <span>{(section.key === 'tier' || section.key === 'label') && <i class={`dot dot-${v.value}`}></i>}{label(section.key, v.value)}</span>
              <span class="count">{v.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}

  {facets.tag.length > 0 && (
    <details open>
      <summary>{t('facets.keywords')}</summary>
      <div class="values keywords" data-keywords>
        {facets.tag.length > KEYWORDS_SHOWN && (
          <input type="search" class="kw-find" placeholder={t('facets.findKeyword')} aria-label={t('facets.findKeyword')} />
        )}
        <KeywordTree nodes={rootKeywords} all={facets.tag} activeId={params.get('kw')} activeTag={params.get('tag')} link={(id) => link({ kw: id, tag: null })} fold={KEYWORDS_SHOWN} />
        <p class="kw-none" data-none hidden>{t('facets.noKeyword')}</p>
        {rootKeywords.length > KEYWORDS_SHOWN && (
          <button type="button" class="kw-more" data-more-button data-all={t('facets.allKeywords', { count: rootKeywords.length })} data-fewer={t('facets.fewerKeywords')}>
            {t('facets.allKeywords', { count: rootKeywords.length })}
          </button>
        )}
      </div>
    </details>
  )}
</aside>

<script>
  // Keywords: typing narrows the tree to the keywords whose path matches (opening the branches they're in);
  // "Show all" unfolds the less used ones.
  for (const box of document.querySelectorAll<HTMLElement>('[data-keywords]')) {
    const find = box.querySelector<HTMLInputElement>('.kw-find')
    const more = box.querySelector<HTMLButtonElement>('[data-more-button]')
    const none = box.querySelector<HTMLElement>('[data-none]')!
    const items = [...box.querySelectorAll<HTMLLIElement>('li')].map((li) => ({
      li,
      paths: [...li.querySelectorAll('a')].map((a) => a.title.toLowerCase()),
      details: li.querySelector(':scope > details') as HTMLDetailsElement | null,
    }))
    for (const { details } of items) if (details) details.dataset.wasOpen = String(details.open)
    let all = false
    const apply = () => {
      const q = find?.value.trim().toLowerCase() ?? ''
      let shown = 0
      for (const { li, paths, details } of items) {
        const match = q ? paths.some((p) => p.includes(q)) : !(li.dataset.more !== undefined && !all)
        li.hidden = !match
        if (match && li.parentElement?.closest('li') === null) shown++
        if (details) details.open = q ? match && paths.slice(1).some((p) => p.includes(q)) : details.dataset.wasOpen === 'true'
      }
      none.hidden = !q || shown > 0
      if (more) {
        more.hidden = q !== ''
        more.textContent = all ? more.dataset.fewer! : more.dataset.all!
      }
    }
    find?.addEventListener('input', apply)
    more?.addEventListener('click', () => {
      all = !all
      apply()
    })
  }
</script>

<style>
  .facets {
    display: grid;
    gap: 6px;
    align-content: start;
    font-size: 0.86rem;
  }
  .active {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }
  .chip {
    display: inline-flex;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 99px;
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    font-size: 0.8rem;
  }
  .chip:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--accent) 26%, transparent);
  }
  .clear {
    font-size: 0.8rem;
    align-self: center;
  }
  details {
    border-bottom: 1px solid var(--border);
    padding: 8px 0;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .values {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
  }
  .values a {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 4px 8px;
    border-radius: 6px;
    color: var(--text-muted);
  }
  .values a span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .values a:hover {
    text-decoration: none;
    background: var(--surface-hover);
    color: var(--text);
  }
  .values a.on {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .kw-find {
    width: 100%;
    margin: 2px 0 6px;
    padding: 5px 8px;
    font-size: 0.82rem;
  }
  .kw-none {
    margin: 4px 8px;
    color: var(--text-faint);
  }
  .kw-more {
    justify-self: start;
    margin: 4px 0 0 8px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
  }
  .kw-more:hover {
    text-decoration: underline;
  }
  .uncounted {
    margin: 0 0 12px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .count {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .stars {
    color: #fbbf24;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 8px;
  }
  .dot-nas {
    background: #a3e635;
  }
  .dot-hot {
    background: #fb923c;
  }
  .dot-warm {
    background: #facc15;
  }
  .dot-cold {
    background: #38bdf8;
  }
  .dot-deep {
    background: #818cf8;
  }
  .dot-red {
    background: var(--label-red);
  }
  .dot-yellow {
    background: var(--label-yellow);
  }
  .dot-green {
    background: var(--label-green);
  }
  .dot-blue {
    background: var(--label-blue);
  }
  .dot-purple {
    background: var(--label-purple);
  }
</style>
