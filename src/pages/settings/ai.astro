---
import { env } from 'cloudflare:workers'
import { getT } from '@cf-dam/i18n'
import { aiStats, facetStats, getAiSettings, siteLanguage, USD_PER_1000_NEURONS, VISION_MODELS } from '@cf-dam/api'
import AppLayout from '../../layouts/AppLayout.astro'
import AiSettings from '../../components/AiSettings.svelte'
import PeopleFacets from '../../components/PeopleFacets.svelte'

const principal = Astro.locals.principal!
const [settings, stats, archiveLanguage, people] = await Promise.all([getAiSettings(env.DB), aiStats(env.DB), siteLanguage(env.DB), facetStats(env)])
const t = getT(Astro.locals.lang)
---
<AppLayout help="ai-review" title={t('ai.title')} subtitle={t('ai.subtitle')}>
  <AiSettings
    client:load
    available={Boolean(env.AI)}
    initialSettings={settings}
    initialStats={stats}
    models={[...VISION_MODELS]}
    usdPer1000Neurons={USD_PER_1000_NEURONS}
    archiveLanguage={archiveLanguage ?? 'en'}
    canManage={principal.permissions.has('settings:manage')}
  />
  <PeopleFacets client:idle initial={people} />
</AppLayout>
