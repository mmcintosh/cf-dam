---
import { env } from 'cloudflare:workers'
import { getPreferences } from '@cf-dam/api'
import { createFormat, getT } from '@cf-dam/i18n'
import AppLayout from '../layouts/AppLayout.astro'
import ApiKeys from '../components/ApiKeys.svelte'
import AppearanceSettings from '../components/AppearanceSettings.svelte'
import LanguageSettings from '../components/LanguageSettings.svelte'
import ChangePassword from '../components/ChangePassword.svelte'
import Passkeys from '../components/Passkeys.svelte'
import Sessions from '../components/Sessions.svelte'
import TwoFactor from '../components/TwoFactor.svelte'

const principal = Astro.locals.principal!
const row = await env.DB.prepare('SELECT two_factor_enabled, created_at FROM users WHERE id = ?')
  .bind(principal.userId)
  .first<{ two_factor_enabled: number; created_at: string }>()
const grantable = [...principal.permissions].sort()
const setup = principal.setup
const canManageKeys = principal.permissions.has('apikeys:manage') && !setup
// After a setup step, on to wherever the middleware sends them next (the Library, or the next step).
const next = setup ? '/' : undefined
const preferences = await getPreferences(env.DB, principal.userId)
const t = getT(Astro.locals.lang)
const since = row ? createFormat(Astro.locals.lang).date(row.created_at) : ''
---
<AppLayout help="account-security" title={t('account.title')} subtitle={t('account.subtitle', { email: principal.email, date: since })}>
  {setup === 'password' && (
    <div class="alert setup" role="status">
      {t('account.setup.password')}
    </div>
  )}
  {setup === 'two_factor' && (
    <div class="alert setup" role="status">
      {t('account.setup.twoFactor')}
    </div>
  )}
  {!setup && (
    <>
    <h2 class="group">{t('account.group.preferences')}</h2>
    <section class="card setting">
      <header>
        <h3>{t('account.language.title')}</h3>
        <p class="lead">{t('account.language.lead')}</p>
      </header>
      <LanguageSettings client:load initial={preferences.language} />
    </section>
    <section class="card setting" id="appearance">
      <header>
        <h3>{t('account.appearance.title')}</h3>
        <p class="lead">{t('account.appearance.lead')}</p>
      </header>
      <AppearanceSettings client:load initial={preferences} />
    </section>
    </>
  )}

  <h2 class="group">{t('account.group.security')}</h2>
  {setup !== 'password' && (
    <section class="card setting">
      <header>
        <h3>{t('account.passkeys.title')}</h3>
        <p class="lead">{t('account.passkeys.lead')}</p>
      </header>
      <Passkeys client:load next={next} />
    </section>
  )}
  {setup !== 'password' && (
    <section class="card setting">
      <header>
        <h3>{t('account.twoFactor.title')}</h3>
        <p class="lead">{t('account.twoFactor.lead')}</p>
      </header>
      <TwoFactor client:load enabled={row?.two_factor_enabled === 1} next={next} />
    </section>
  )}
  {setup !== 'two_factor' && (
    <section class="card setting">
      <header>
        <h3>{t('account.password.title')}</h3>
        <p class="lead">{t('account.password.lead')}</p>
      </header>
      <ChangePassword client:load next={next} />
    </section>
  )}
  {!setup && (
    <section class="card setting">
      <header>
        <h3>{t('account.sessions.title')}</h3>
        <p class="lead">{t('account.sessions.lead')}</p>
      </header>
      <Sessions client:load />
    </section>
  )}

  {canManageKeys && (
    <>
    <h2 class="group">{t('account.group.integrations')}</h2>
    <section class="card setting">
      <header>
        <h3>{t('account.apiKeys.title')}</h3>
        <p class="lead">{t('account.apiKeys.lead')}</p>
      </header>
      <ApiKeys client:load grantable={grantable} />
    </section>
    </>
  )}
</AppLayout>

<style>
  /* One column of sections: what it is on the left, the controls on the right (stacked when narrow). */
  .group {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin: 32px 0 12px;
    max-width: 1040px;
  }
  .group:first-of-type {
    margin-top: 8px;
  }
  .setting {
    display: grid;
    grid-template-columns: minmax(200px, 280px) minmax(0, 1fr);
    gap: 16px 40px;
    max-width: 1040px;
    margin-bottom: 16px;
  }
  .setting h3 {
    margin: 0 0 6px;
    font-size: 1.05rem;
  }
  .setting .lead {
    margin: 0;
  }
  @media (max-width: 860px) {
    .setting {
      grid-template-columns: 1fr;
    }
  }
  .setup {
    margin-bottom: 20px;
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
</style>
