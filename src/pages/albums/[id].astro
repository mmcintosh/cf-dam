---
import { env } from 'cloudflare:workers'
import { getWatermark, listAssets } from '@cf-dam/api'
import AppLayout from '../../layouts/AppLayout.astro'
import AssetGrid from '../../components/AssetGrid.astro'
import SharePanel from '../../components/SharePanel.svelte'
import AlbumTools from '../../components/AlbumTools.svelte'

const id = Astro.params.id!
const album = await env.DB.prepare(
  `SELECT id, name, description,
     COALESCE(cover_asset_id, (SELECT ai.asset_id FROM album_items ai WHERE ai.album_id = albums.id ORDER BY ai.position, ai.added_at LIMIT 1)) AS cover,
     (SELECT COUNT(*) FROM shares s WHERE s.album_id = albums.id) AS links
   FROM albums WHERE id = ?`,
)
  .bind(id)
  .first<{ id: string; name: string; description: string; cover: string | null; links: number }>()
if (!album) return new Response('Not found', { status: 404 })
const { assets, total, totalExact } = await listAssets(env.DB, { albumId: id, limit: 200 })
const canShare = Astro.locals.principal!.permissions.has('shares:manage')
const canEdit = Astro.locals.principal!.permissions.has('assets:edit')
const items = assets.map((a) => ({ id: a.id, name: a.title ?? a.filename, alt: a.alt ?? a.title ?? a.filename, thumb: a.renditions.includes('thumb'), version: a.imageVersion }))
const hasWatermark = canShare && (await getWatermark(env.DB)).version !== null
---
<AppLayout help="albums" wide title={album.name} subtitle={album.description || `${total.toLocaleString()}${totalExact ? '' : '+'} ${total === 1 && totalExact ? 'item' : 'items'}`}>
  {canEdit && <AlbumTools client:load albumId={album.id} name={album.name} description={album.description} links={album.links} items={items} coverId={album.cover} />}
  {canShare && (
    <div class="share">
      <SharePanel client:load albumId={album.id} albumName={album.name} hasWatermark={hasWatermark} />
    </div>
  )}
  {assets.length > 0 ? (
    <AssetGrid assets={assets} />
  ) : (
    <p class="muted">This album is empty. Select photos in the <a href="/">library</a> and choose <strong>Add to album…</strong>, or add one from its own page.</p>
  )}
</AppLayout>

<style>
  .share {
    margin-bottom: 24px;
  }
</style>
