---
import { env } from 'cloudflare:workers'
import { exactGroups, similarGroups } from '@cf-dam/api'
import AppLayout from '../layouts/AppLayout.astro'
import Duplicates from '../components/Duplicates.svelte'

const principal = Astro.locals.principal!
const kind = Astro.url.searchParams.get('kind') === 'similar' ? 'similar' : 'exact'
const [exact, similar] = await Promise.all([exactGroups(env.DB, kind === 'exact' ? 50 : 0), similarGroups(env.DB, kind === 'similar' ? 50 : 0)])
const groups = kind === 'exact' ? exact.groups : similar.groups
---
<AppLayout help="duplicates" wide title="Duplicates" subtitle="Identical files and look-alikes (resized copies, re-saved JPEGs, light edits).">
  <nav class="tabs" aria-label="Kind of duplicate">
    <a href="/duplicates" class:list={{ on: kind === 'exact' }}>Exact copies <span class="badge">{exact.total}</span></a>
    <a href="/duplicates?kind=similar" class:list={{ on: kind === 'similar' }}>Look-alikes <span class="badge">{similar.total}</span></a>
  </nav>
  <Duplicates
    client:load
    kind={kind}
    initial={groups}
    canDelete={principal.permissions.has('assets:delete')}
    canEdit={principal.permissions.has('assets:edit')}
  />
</AppLayout>

<style>
  .tabs {
    display: flex;
    gap: 6px;
    margin-bottom: 18px;
  }
  .tabs a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 7px 14px;
    border-radius: 99px;
    color: var(--text-muted);
    border: 1px solid var(--border);
  }
  .tabs a:hover {
    text-decoration: none;
    color: var(--text);
  }
  .tabs a.on {
    color: var(--text);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
</style>
