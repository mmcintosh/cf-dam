---
/** One level of the keyword facet: each keyword links to its filter; branches fold. Renders itself for children. */
import type { KeywordFacet } from '@cf-dam/api'

interface Props {
  nodes: KeywordFacet[]
  all: KeywordFacet[]
  /** The keyword chosen in this tree (`kw=`), by id. */
  activeId: string | null
  /** Or a keyword typed by name or path (`tag=`): every keyword it means is lit. */
  activeTag: string | null
  link: (id: string | null) => string
  /** Top level only: keywords from this index on start folded away ("Show all"), unless the chosen one is there. */
  fold?: number
}
const { nodes, all, activeId, activeTag, link, fold = Infinity } = Astro.props
const children = (id: string) => all.filter((k) => k.parentId === id)
const typed = activeTag?.toLowerCase().replace(/\s*(?:>|\||›)\s*/g, ' › ')
const chosenPath = all.find((k) => k.id === activeId)?.path.toLowerCase() ?? typed
const isActive = (k: KeywordFacet) => k.id === activeId || (!activeId && !!typed && (typed === k.path.toLowerCase() || (!typed.includes('›') && typed === k.name.toLowerCase())))
// Open a branch when the active keyword is inside it.
const contains = (k: KeywordFacet) => !!chosenPath && chosenPath.startsWith(`${k.path.toLowerCase()} › `)
---
<ul class="kw">
  {nodes.map((k, index) => {
    const kids = children(k.id)
    const folded = index >= fold && !isActive(k) && !contains(k)
    const row = (
      <a href={link(k.id === activeId ? null : k.id)} class:list={['kw-link', { on: isActive(k) }]} title={k.path}>
        <span>{k.name}</span><span class="count">{k.count}</span>
      </a>
    )
    return (
      <li data-more={folded ? '' : undefined} hidden={folded}>
        {kids.length > 0 ? (
          <details open={contains(k) || isActive(k)}>
            <summary class="kw-summary">{row}</summary>
            <Astro.self nodes={kids} all={all} activeId={activeId} activeTag={activeTag} link={link} />
          </details>
        ) : row}
      </li>
    )
  })}
</ul>

<style>
  .kw {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
  }
  .kw .kw {
    margin-left: 12px;
    padding-left: 6px;
    border-left: 1px solid var(--border);
  }
  details {
    border: 0;
    padding: 0;
  }
  .kw-summary {
    list-style: none;
    display: block;
    position: relative;
    cursor: pointer;
  }
  .kw-summary::-webkit-details-marker {
    display: none;
  }
  .kw-summary::before {
    content: '▸';
    position: absolute;
    left: -10px;
    top: 5px;
    font-size: 0.65rem;
    color: var(--text-faint);
    transition: transform 120ms var(--ease);
  }
  details[open] > .kw-summary::before {
    transform: rotate(90deg);
  }
  .kw-link {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 4px 8px;
    border-radius: 6px;
    color: var(--text-muted);
  }
  .kw-link span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .kw-link:hover {
    text-decoration: none;
    background: var(--surface-hover);
    color: var(--text);
  }
  .kw-link.on {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .count {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
</style>
