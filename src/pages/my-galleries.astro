---
/** A client's home: the galleries they were invited to (catalog/clients.ts). The team has albums instead. */
import { env } from 'cloudflare:workers'
import { clientGalleries, isClientOnly } from '@cf-dam/api'
import { createFormat, currentTimeZone, getT } from '@cf-dam/i18n'
import AppLayout from '../layouts/AppLayout.astro'
import GalleryEmails from '../components/GalleryEmails.svelte'

const principal = Astro.locals.principal!
if (!isClientOnly(principal.roles)) return Astro.redirect('/galleries')
const galleries = await clientGalleries(env.DB, principal.userId)
const open = galleries.filter((g) => !g.expired)
const t = getT(Astro.locals.lang)
// The last day it's open (expiry is the start of the next day).
const until = (iso: string) => createFormat(Astro.locals.lang, currentTimeZone()).date(new Date(iso).getTime() - 1)
const first = (principal.name || '').split(/\s+/)[0]
// Grouped by job (its client-facing name), the newest first; galleries from no job after them.
const groups: { key: string; title: string | null; date: string | null; galleries: typeof galleries }[] = []
for (const g of galleries) {
  const key = g.job?.id ?? ''
  let group = groups.find((x) => x.key === key)
  if (!group) groups.push((group = { key, title: g.job?.title ?? null, date: g.job?.shootStart ?? null, galleries: [] }))
  group.galleries.push(g)
}
groups.sort((a, b) => Number(a.key === '') - Number(b.key === ''))
const grouped = groups.some((g) => g.key !== '')
// A calendar day (the shoot's): noon UTC is that day whatever the zone the format uses (UTC on the server).
const day = (ymd: string) => createFormat(Astro.locals.lang).date(`${ymd}T12:00:00Z`)
---
<AppLayout title={t('mine.title')} subtitle={first ? t('mine.welcome', { name: first }) : undefined}>
  {galleries.length === 0 ? (
    <div class="card empty">
      <h2>{t('mine.empty.title')}</h2>
      <p class="muted">{t('mine.empty.lead')}</p>
    </div>
  ) : groups.map((group) => (
    <section class="group">
      {grouped && (
        <h2 class="group-title">
          {group.title ?? t('mine.otherGalleries')}
          {group.date && <span class="muted small"> · {day(group.date)}</span>}
        </h2>
      )}
    <ul class="galleries">
      {group.galleries.map((g) => (
        <li class:list={['gallery', { expired: g.expired }]}>
          <a href={`/s/${g.token}`}>
            <span class="cover">
              {g.coverId && !g.expired ? <img src={`/api/public/galleries/${g.token}/assets/${g.coverId}/thumb`} alt="" loading="lazy" /> : <span class="muted">{g.expired ? t('mine.closed') : t('mine.noPhotos')}</span>}
            </span>
            <strong>{g.title}</strong>
            <span class="muted small">
              {t('common.photos', { count: g.photos })}
              {g.expired ? ` · ${t('mine.closedSuffix')}` : g.expiresAt ? ` · ${t('gallery.openUntil', { date: until(g.expiresAt) })}` : ''}
            </span>
            {g.message && !g.expired && <span class="message small">{g.message}</span>}
          </a>
          {!g.expired && <GalleryEmails client:visible token={g.token} off={g.emailsOff} />}
        </li>
      ))}
    </ul>
    </section>
  ))}
  {open.length > 0 && (
    <p class="muted small hint">{t('mine.hint')}</p>
  )}
</AppLayout>

<style>
  .galleries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }
  .gallery a {
    display: grid;
    gap: 6px;
    color: var(--text);
  }
  .gallery a:hover {
    text-decoration: none;
  }
  .cover {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--surface-strong);
    border: 1px solid var(--border);
    transition: transform 200ms var(--ease);
  }
  .gallery a:hover .cover {
    transform: translateY(-3px);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .expired {
    opacity: 0.6;
  }
  .message {
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .small {
    font-size: 0.875rem;
  }
  .group + .group {
    margin-top: 36px;
  }
  .group-title {
    font-size: 1.125rem;
    margin: 0 0 14px;
  }
  .empty h2 {
    margin-bottom: 6px;
  }
  .hint {
    margin-top: 28px;
    max-width: 640px;
  }
</style>
