---
import { env } from 'cloudflare:workers'
import { listAssets, listConnections } from '@cf-dam/api'
import AppLayout from '../layouts/AppLayout.astro'
import AssetGrid from '../components/AssetGrid.astro'
import Uploader from '../components/Uploader.svelte'

const principal = Astro.locals.principal!
const params = Astro.url.searchParams
const q = params.get('q') ?? ''
const tag = params.get('tag') ?? ''
const sort = params.get('sort') === 'added' ? 'added' : 'captured'
const page = Math.max(1, Number(params.get('page') ?? 1) || 1)
const PAGE = 120

const canRead = principal.permissions.has('assets:read')
const canUpload = principal.permissions.has('assets:upload')
const { assets, total } = canRead
  ? await listAssets(env.DB, { q: q || undefined, tag: tag || undefined, sort, limit: PAGE, offset: (page - 1) * PAGE })
  : { assets: [], total: 0 }
const connections = canUpload
  ? (await listConnections(env.DB)).map((c) => ({ id: c.id, name: c.name, storageClasses: c.storageClasses, defaultClass: c.defaultClass, isDefault: c.isDefault }))
  : []
const filtered = Boolean(q || tag)
const link = (changes: Record<string, string | null>) => {
  const next = new URLSearchParams(params)
  for (const [k, v] of Object.entries(changes)) v === null ? next.delete(k) : next.set(k, v)
  const s = next.toString()
  return s ? `/?${s}` : '/'
}
const subtitle = filtered
  ? `${total} ${total === 1 ? 'match' : 'matches'}${q ? ` for “${q}”` : ''}${tag ? ` tagged ${tag}` : ''}`
  : `${total} ${total === 1 ? 'item' : 'items'}`
---
<AppLayout title="Library" subtitle={subtitle}>
  {total === 0 && !filtered ? (
    <div class="empty stack">
      <div class="card hero">
        <h2>Your archive starts here</h2>
        <p class="muted">
          Drop in a few photos. Each one is read for camera, lens, date and place, given a thumbnail and a preview, and made
          searchable. Originals go wherever you choose, from hot R2 to S3 Glacier Deep Archive.
        </p>
      </div>
      {canUpload && <Uploader client:load connections={connections} open />}
    </div>
  ) : (
    <div class="stack">
      <div class="toolbar row">
        <nav class="sort" aria-label="Sort">
          <a href={link({ sort: null, page: null })} class:list={{ on: sort === 'captured' }}>By date taken</a>
          <a href={link({ sort: 'added', page: null })} class:list={{ on: sort === 'added' }}>Recently added</a>
        </nav>
        {filtered && <a class="btn btn-sm" href="/">Clear search</a>}
        <span class="spacer"></span>
        {canUpload && <Uploader client:idle connections={connections} />}
      </div>
      {assets.length > 0 ? <AssetGrid assets={assets} /> : <p class="muted">Nothing matches. Try fewer words.</p>}
      {total > PAGE && (
        <div class="row pager">
          {page > 1 && <a class="btn" href={link({ page: String(page - 1) })}>Newer</a>}
          <span class="muted">Page {page} of {Math.ceil(total / PAGE)}</span>
          {page * PAGE < total && <a class="btn" href={link({ page: String(page + 1) })}>Older</a>}
        </div>
      )}
    </div>
  )}
</AppLayout>

<style>
  .hero h2 {
    font-size: 1.4rem;
  }
  .hero p {
    max-width: 640px;
    margin: 10px 0 0;
  }
  .toolbar {
    justify-content: space-between;
    align-items: flex-start;
  }
  .toolbar :global(.uploader) {
    flex-basis: 100%;
    order: 10;
  }
  .spacer {
    flex: 1;
  }
  .sort {
    display: flex;
    gap: 4px;
    padding: 3px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .sort a {
    padding: 5px 12px;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 550;
  }
  .sort a:hover {
    text-decoration: none;
    color: var(--text);
  }
  .sort a.on {
    background: var(--surface-strong);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  .pager {
    justify-content: center;
  }
</style>
